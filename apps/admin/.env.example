# Admin panel — faqat server env (NEXT_PUBLIC_ emas). Bu fayldan .env.local yarating.
# Baza: serverda postgres://user:pass@localhost:5432/meningfermam ; lokal: pglite:./.data/dev
DATABASE_URL="pglite:./.data/dev"
# 32 baytli kalit: openssl rand -base64 32  (yo'qolsa TOTP sirlari va zaxira kodlar ishlamaydi — zaxiralang)
ADMIN_ENC_KEY=""
# Caddy/nginx orqasida: 1 (IP bo'yicha cheklov uchun X-Forwarded-For ishonchli)
TRUST_PROXY="0"
# Sizib chiqqan parol tekshiruvi (api.pwnedpasswords.com, k-anonimlik): 1
PWNED_CHECK="1"
# Ommaviy saytning barqaror production domeni
PUBLIC_SITE_URL=""
