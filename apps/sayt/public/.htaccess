# MeningFermam — statik sayt uchun Apache sozlamasi (out/ papkasi bilan birga yuklanadi).
# Toza URL: /yem-rejasi → yem-rejasi.html; topilmasa 404.html; HTTPS majburiy; xavfsizlik sarlavhalari.

Options -Indexes -MultiViews
DirectoryIndex index.html
# Next har sahifa uchun ham aloqa.html, ham aloqa/ papkasini yaratadi: /aloqa papkaga yo'naltirilmasin
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS va www'siz manzil (canonical: https://meningfermam.uz)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://meningfermam.uz%{REQUEST_URI} [R=301,L]

  # oxiridagi "/" ni olib tashlash (/yem-rejasi/ → /yem-rejasi), agar shunday sahifa bo'lsa
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # .html'siz so'rov → .html fayl
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Minimal CSP: inline skriptlarni cheklamaydi (Next statik eksporti ularni ishlatadi), lekin ramkaga joylash,
  # <base> almashtirish, plaginlar va boshqa saytga forma yuborishni taqiqlaydi
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # Kesh (ERR-004): faqat /_next/static/ dagi fayllar nomida xesh bor — ular o'zgarmaydi.
  # Logo, ikonka, og.png kabi nomi o'zgarmaydigan fayllar 1 kun; HTML va sahifa ma'lumotlari har safar tekshiriladi.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#\.(png|webp|ico|svg|woff2)$#">
    Header set Cache-Control "public, max-age=86400"
  </ElseIf>
  <Else>
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Else>
</IfModule>

# Siqish (ERR-003): matnli fayllar ~3–4 baravar kichrayadi (JS, CSS, HTML, sahifa ma'lumotlari)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/javascript .js
  AddType text/plain .txt
</IfModule>
